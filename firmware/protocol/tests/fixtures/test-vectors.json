{
  "firmware_version": 1,
  "description": "Canonical wire-format test vectors. Both the Kotlin builder and the Rust parser must agree on every case. Block ids are 4 bits, packed two per payload byte (high nibble first); a 0x0 nibble pads an odd-length sequence. Update this file when the protocol changes — CI will catch any side that doesn't follow.",
  "block_ids": {
    "CLICK":           "0x1",
    "SHORT_BUZZ":      "0x2",
    "MEDIUM_BUZZ":     "0x3",
    "LONG_BUZZ":       "0x4",
    "EXTRA_LONG_BUZZ": "0x5",
    "SHORT_PAUSE":     "0xA",
    "MEDIUM_PAUSE":    "0xB",
    "LONG_PAUSE":      "0xC"
  },
  "cases": [
    {
      "id": "short-pulse",
      "description": "VibrationMode.SHORT_PULSE — single short buzz, packed alone in one byte",
      "block_ids": [2],
      "repeat": 1,
      "bytes_hex": "01 01 01 20",
      "decoded_blocks": [
        { "id": 2, "motor_on": true, "duration_ms": 100 }
      ]
    },
    {
